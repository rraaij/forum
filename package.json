{
  "name": "forum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "tsc -b && biome check --write .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc --project apps/forum/tsconfig.json --noEmit",
    "db:generate:dev": "pnpm --filter @forum/db run db:generate:dev",
    "db:migrate:dev": "pnpm --filter @forum/db run db:migrate:dev",
    "db:migrate:test": "pnpm --filter @forum/db run db:migrate:test",
    "db:seed:dev": "pnpm --filter @forum/db run db:seed:dev",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
