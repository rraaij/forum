{
  "name": "@forum/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./safe-target": "./src/safe-target.ts"
  },
  "scripts": {
    "db:generate": "set -a && . ../../.env && set +a && drizzle-kit generate",
    "db:migrate": "bun --bun --env-file=../../.env scripts/dedupe-forum-identifiers.ts && set -a && . ../../.env && set +a && drizzle-kit migrate",
    "db:push": "set -a && . ../../.env && set +a && drizzle-kit push",
    "db:studio": "set -a && . ../../.env && set +a && drizzle-kit studio",
    "db:seed": "bun --bun --env-file=../../.env scripts/seed.ts",
    "db:dedupe-identifiers": "bun --bun --env-file=../../.env scripts/dedupe-forum-identifiers.ts",
    "db:generate:dev": "bun scripts/safe-db.ts dev generate",
    "db:migrate:test": "bun scripts/safe-db.ts test migrate",
    "db:migrate:dev": "bun scripts/safe-db.ts dev migrate",
    "db:seed:dev": "bun scripts/safe-db.ts dev seed",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@forum/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "@types/bun": "^1.3.14",
    "vitest": "^4.1.6"
  }
}
