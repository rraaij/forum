# Development environment (docker-compose.dev.yml). Copy to .env.dev.
# NEVER copy values from the normal .env (QNAP) into this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=forum_dev
POSTGRES_USER=forum
POSTGRES_PASSWORD=forum

# Local development secret (>= 32 characters). Generate your own with:
# openssl rand -base64 32
AUTH_SECRET=forum-dev-only-secret-0123456789abcdef

# Loopback-only URLs for manual local verification (dev:dev).
APP_URL=http://localhost:3001
API_URL=http://localhost:4000
API_PORT=4000
