# Test environment (docker-compose.test.yml). Copy to .env.test.
# These are throwaway local-container values, not secrets.
# NEVER copy values from the normal .env (QNAP) into this file.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=forum_test
POSTGRES_USER=forum
POSTGRES_PASSWORD=forum

# Test-only Better Auth secret (>= 32 characters, not a real secret).
AUTH_SECRET=forum-test-only-secret-0123456789abcdef

# Loopback-only URLs for the test API and frontend started by Playwright.
APP_URL=http://localhost:3101
API_URL=http://localhost:4100
API_PORT=4100
